{
  "name": "intelligence",
  "version": "1.0.0",
  "private": true,
  "description": "Financial process intelligence, Excel ingestion, and Tally reconciliation",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/migrate.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "nodemonConfig": {
    "watch": ["src", "migrations"],
    "ignore": ["storage", "ui", "scripts", "test", "samples"]
  }
}
