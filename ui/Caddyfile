{
    admin off
    auto_https off
}
:8080 {
    encode gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
    handle /healthz {
        respond "enterprise-dashboard {$RELEASE_TAG}" 200
    }
    # Machine endpoint authenticates its Bearer token in Express.
    @sender path /api/ingest/tally /api/ingest/tally/begin /api/ingest/tally/chunk /api/ingest/tally/complete /api/ingest/tally/source/begin /api/ingest/tally/source/chunk /api/ingest/tally/source/complete /api/ingest/tally/source-period/preflight /api/ingest/tally/source-period/begin /api/ingest/tally/source-period/chunk /api/ingest/tally/source-period/complete /api/ingest/tally/source-period-replace/preflight /api/ingest/tally/source-period-replace/begin /api/ingest/tally/source-period-replace/chunk /api/ingest/tally/source-period-replace/complete /api/process/tally/unpack
    handle @sender {
        reverse_proxy enterprise-dashboard-api:3000
    }
    handle /api/* {
        reverse_proxy enterprise-dashboard-api:3000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
